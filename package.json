    "@react-navigation/native-stack": "^7.3.10",
    "@siteed/sherpa-onnx.rn": "^1.3.1",
    "@types/d3-sankey": "^0.12.5",
    "buffer": "^6.0.3",
    "d3-sankey": "^0.12.3",
    "date-fns": "^4.1.0",
    "i18next": "^25.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "llama.rn": "^0.12.6",
