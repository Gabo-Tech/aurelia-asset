{
  "name": "financial-tracker",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "windows": "react-native run-windows",
    "macos": "react-native run-macos",
    "web": "vite --config web-app/vite.config.ts",
    "web:build": "vite build --config web-app/vite.config.ts",
    "web:site": "npm --prefix web run dev",
    "web:site:build": "npm --prefix web run build",
    "web:site:tauri": "npm --prefix web run build:tauri",
    "prepare:android-web": "npm run web:site:tauri && node scripts/copy-web-assets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "pods": "cd ios && bundle exec pod install",
    "setup:models": "node scripts/copy-bundled-models.mjs",
    "init:windows": "bash scripts/init-windows.sh",
    "init:macos": "bash scripts/init-macos.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
